# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Generate strong random secrets with:
#   openssl rand -hex 32

# ---- Required ----
POSTGRES_PASSWORD=change-me-generate-a-random-value
JWT_SECRET=change-me-generate-a-random-value

# Base URL the frontend uses to reach the backend API, and the public URL
# of the app itself. Update both to your real domain (or http://localhost
# for local dev).
NEXT_PUBLIC_API_URL=http://localhost/api
FRONTEND_URL=http://localhost

# ---- Ollama ----
# Single instance:
OLLAMA_URL=http://host.docker.internal:11434
# Optional: comma-separated list for multi-GPU load balancing (see
# backend/src/lib/ollama.ts). Leave unset for a single-GPU/CPU setup.
# OLLAMA_URLS=http://host.docker.internal:11434,http://host.docker.internal:11435

# Optional: force which local model answers the built-in "Need help?"
# support chat (backend/src/routes/support.ts). Leave unset to auto-pick
# whatever chat-capable model is already installed.
# SUPPORT_MODEL=llama3.1:8b

# ---- Optional: GPU stats override (Admin > System) ----
# COMPOSE_GPU_OVERRIDE=docker-compose.gpu.yml

# ---- Optional: in-panel updates (Admin > Updates) ----
# Points the admin panel at this project's GitHub repo so it can check for
# and apply new releases with one click. Uncomment to enable — leave it
# commented out (or unset) if you don't want self-service updates.
# UPDATE_REPO=visiyondotcom/visiyonai
# UPDATE_BRANCH=main
# Bump this on every release/tag so the version shown in the sidebar and
# the update check stay accurate.
# APP_VERSION=1.0.0


# ---- Optional: SSO (OIDC) — leave blank to configure from Admin > Settings instead ----
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=
# OIDC_REDIRECT_URI=

# ---- Optional: music generation provider ----
# MUSIC_GEN_URL=
# MUSIC_GEN_API_KEY=
# MUSIC_GEN_CALLBACK_URL=

# ---- Optional: text-to-speech — leave blank to configure from Admin >
# Settings > Voice instead. Only used when "ElevenLabs" is the selected
# TTS provider (Piper/Kokoro/Coqui are self-hosted and need no key).
# ELEVENLABS_API_KEY=
